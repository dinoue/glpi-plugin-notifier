#: src/Config.php:129
msgid "Notifier"
msgstr "Notifier"

#: src/Config.php:146
msgid "Notification bell settings"
msgstr "Ajustes de la campana de notificaciones"

#: src/Config.php:151
msgid "General"
msgstr "General"

#: src/Config.php:155
msgid "Polling interval (seconds)"
msgstr "Intervalo de sondeo (segundos)"

#: src/Config.php:158
msgid "How often an open page checks for new notifications. Hidden tabs pause automatically."
msgstr "Con qué frecuencia una página abierta busca notificaciones nuevas. Las pestañas ocultas se pausan automáticamente."

#: src/Config.php:163
msgid "Notifications per page"
msgstr "Notificaciones por página"

#: src/Config.php:166
msgid "Size of one batch in the panel. Users can load more."
msgstr "Cantidad que se carga de una vez en el panel. Los usuarios pueden cargar más."

#: src/Config.php:171
msgid "Retention (days)"
msgstr "Retención (días)"

#: src/Config.php:174
msgid "Read notifications older than this are purged by the NotifierCleanup cron task. 0 keeps everything."
msgstr "Las notificaciones leídas más antiguas que esto las purga la tarea programada NotifierCleanup. 0 lo conserva todo."

#: src/Config.php:179
msgid "Show the bell in the self-service interface"
msgstr "Mostrar la campana en la interfaz de autoservicio"

#: src/Config.php:181
msgid "On by default. Turn this off to limit the bell to the central (technician) interface."
msgstr "Activado por defecto. Desactívalo para limitar la campana a la interfaz central (técnico)."

#: src/Config.php:185
msgid "Features"
msgstr "Funciones"

#: src/Config.php:189
msgid "Enable @-mentions"
msgstr "Activar menciones @"

#: src/Config.php:191
msgid "Naming a user in a followup, task or solution notifies them even when they are not an actor on the item."
msgstr "Nombrar a un usuario en un seguimiento, tarea o solución le avisa aunque no sea actor del elemento."

#: src/Config.php:196
msgid "Enable quick actions"
msgstr "Activar acciones rápidas"

#: src/Config.php:198
msgid "Take the item, change its status or post a followup straight from the bell. Every action is rights-checked."
msgstr "Toma el elemento, cambia su estado o publica un seguimiento directamente desde la campana. Cada acción comprueba los permisos."

#: src/Config.php:203
msgid "Enable snooze"
msgstr "Activar posponer"

#: src/Config.php:205
msgid "Lets users hide a notification until later instead of marking it read."
msgstr "Permite a los usuarios ocultar una notificación hasta más tarde en lugar de marcarla como leída."

#: src/Config.php:210
msgid "Enable entity watch"
msgstr "Activar seguimiento de entidades"

#: src/Config.php:212
msgid "Lets technicians opt in to a bell for every new ticket, change or problem created in an entity they have update rights in, even before anyone is assigned."
msgstr "Permite a los técnicos recibir una notificación por cada ticket, cambio o problema nuevo creado en una entidad en la que tienen derechos de actualización, incluso antes de que se asigne a alguien."

#: src/Config.php:217
msgid "Enable deadline notifications"
msgstr "Activar notificaciones de vencimiento"

#: src/Config.php:219
msgid "The NotifierDeadline cron task warns assignees before and after the resolution deadline is reached."
msgstr "La tarea programada NotifierDeadline avisa a los asignados antes y después de alcanzar el vencimiento de resolución."

#: src/Config.php:224
msgid "Deadline warning lead time (minutes)"
msgstr "Antelación del aviso de vencimiento (minutos)"

#: src/Config.php:227
msgid "How long before time to resolve the first warning fires."
msgstr "Cuánto antes del tiempo de resolución se lanza el primer aviso."

#: src/Config.php:231
msgid "Event types"
msgstr "Tipos de evento"

#: src/Config.php:233
msgid "Turn an event off here and it is never recorded for anyone. Users can additionally opt out per event in their own preferences."
msgstr "Desactiva un evento aquí y no se registrará para nadie. Además, los usuarios pueden desactivarlo por evento en sus preferencias."

