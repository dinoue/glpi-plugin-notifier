#: ajax/boot.php:110
msgid "Desktop notifications"
msgstr "デスクトップ通知"

#: ajax/boot.php:111
msgid "Show a system notification when something new arrives. Your browser will ask for permission."
msgstr "新しい通知があった際にシステム通知を表示します。ブラウザから確認が表示されます。"

#: ajax/boot.php:112
msgid "Play a sound"
msgstr "音を鳴らす"

#: ajax/boot.php:113
msgid "A short chime when a new notification arrives."
msgstr "新しい通知があった際に短いチャイムを鳴らします。"

#: ajax/boot.php:114
msgid "Your browser blocked notifications for this site."
msgstr "ブラウザがこのサイトからの通知をブロックしています。"

